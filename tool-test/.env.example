# ============================================
# 复制本文件为 .env 后再填你自己的 Key：
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略，永远不会提交到 git。
# 本文件（.env.example）只含键名和占位说明，可以安全提交。
# ============================================

# 智谱 AI (BigModel) API Key
# 获取：https://open.bigmodel.cn/  ->  API Keys（只在创建时完整展示一次）
# 注意：必须纯 ASCII，不要加引号、不要留空格
OPENAI_API_KEY=

# 智谱 OpenAI 兼容端点（固定，不用改）
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 模型：glm-5.3（旗舰）/ glm-5.3-flash（便宜约 10 倍）
MODEL_NAME=glm-5.3

# 思考强度：low / high / max
# GLM-5.3 强制开启思考，默认 max 会产出很长的思考链，demo 用 low 足够
REASONING_EFFORT=low
