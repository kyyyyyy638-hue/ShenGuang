# ============================================
# 仓库根 .gitignore
# 放在这一层，对下面所有子项目（tool-test 及以后新增的）统一生效
# ============================================

# 依赖目录（全层级）
node_modules/

# 密钥与本地配置 —— 绝不提交
.env
.env.*
!.env.example

# 日志
*.log

# WorkBuddy 工作区数据（项目笔记，不上传）
.workbuddy/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 构建产物
dist/
build/
